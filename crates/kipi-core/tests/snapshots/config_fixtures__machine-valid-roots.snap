            line: Some(
                2,
            ),
            store: None,
        },
    },
    MachineRoots {
        scope: "main-ml",
        roots: [],
        at: Location {
            file: "<dir>/machine.toml",
            line: Some(
                3,
            ),
            store: None,
        },
    },
]
repos: []
