{
  "version": 1,
  "repos": [
    {
      "name": "acme-api",
      "store": "acme",
      "at": "acme:bindings.toml:30",
      "path": "/Volumes/work/acme/api",
      "scope": {
        "value": "acme",
        "source": {
          "rule": "machine.toml [roots] acme",
          "at": "[HOME]/.config/kipi/machine.toml:7"
        }
      },
      "chain": [
        "acme"
      ],
      "skills": [
        {
          "name": "code-review",
          "store": "acme",
          "reference": "code-review",
          "dir": "[HOME]/stores/acme-store/skills/code-review",
          "inherited_from": "acme",
          "source": {
            "rule": "scopes.acme.skills",
            "at": "acme:bindings.toml:13"
          }
        },
        {
          "name": "pr-conventions",
          "store": "acme",
          "reference": "pr-conventions",
          "dir": "[HOME]/stores/acme-store/skills/pr-conventions",
          "inherited_from": "acme",
          "source": {
            "rule": "scopes.acme.skills",
            "at": "acme:bindings.toml:13"
          }
        },
        {
          "name": "commit-style",
          "store": "personal",
          "reference": "personal/commit-style",
          "dir": "[HOME]/stores/personal-store/skills/commit-style",
          "inherited_from": "acme",
          "source": {
            "rule": "scopes.acme.skills",
            "at": "acme:bindings.toml:13"
          }
        }
      ],
      "excluded": [],
      "always": [
        {
          "kind": "file",
          "path": "[HOME]/stores/acme-store/conventions/acme.md",
          "scope": "acme",
          "source": {
            "rule": "scopes.acme.always",
            "at": "acme:bindings.toml:13"
          }
        },
        {
          "kind": "registry",
          "scope": "acme",
          "source": {
            "rule": "scopes.acme.registry",
            "at": "acme:bindings.toml:13"
          }
        },
        {
          "kind": "this-repo"
        }
      ],
      "registry": {
        "value": "acme",
        "source": {
          "rule": "scopes.acme.registry",
          "at": "acme:bindings.toml:13"
        }
      },
      "related": [],
      "grant": {
        "mode": {
          "value": "related",
          "source": {
            "rule": "defaults.grant",
            "at": "acme:bindings.toml:8"
          }
        },
        "dirs": [
          {
            "path": "[HOME]/stores/acme-store/repos",
            "kind": "store-repos",
            "store": "acme",
            "repo": null,
            "source": {
              "rule": "grant: store `acme` dirs",
              "at": null
            }
          },
          {
            "path": "[HOME]/stores/acme-store/skills",
            "kind": "store-skills",
            "store": "acme",
            "repo": null,
            "source": {
              "rule": "grant: store `acme` dirs",
              "at": null
            }
          },
          {
            "path": "[HOME]/stores/personal-store/skills",
            "kind": "store-skills",
            "store": "personal",
            "repo": null,
            "source": {
              "rule": "scopes.acme.skills",
              "at": "acme:bindings.toml:13"
            }
          }
        ]
      },
      "agents": {
        "value": [
          "claude",
          "generic"
        ],
        "source": {
          "rule": "defaults.agents",
          "at": "acme:bindings.toml:8"
        }
      },
      "budget_tokens": {
        "value": 4000,
